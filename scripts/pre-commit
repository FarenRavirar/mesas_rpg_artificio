#!/bin/sh
# Pre-commit hook: Verifica se há arquivos modificados não staged

# Obter arquivos modificados mas não staged
UNSTAGED=$(git diff --name-only)

if [ -n "$UNSTAGED" ]; then
    echo "❌ COMMIT BLOQUEADO: Há arquivos modificados não incluídos no commit:"
    echo ""
    echo "$UNSTAGED" | sed 's/^/  - /'
    echo ""
    echo "Escolha uma das opções:"
    echo "  1. git add <arquivo>  - para adicionar arquivos específicos"
    echo "  2. git add -u         - para adicionar todos os arquivos rastreados modificados"
    echo "  3. git commit -a      - para commitar todos os arquivos modificados"
    echo ""
    exit 1
fi

# Verificar se há arquivos TypeScript/TSX com erros de tipo
if git diff --cached --name-only | grep -E '\.(ts|tsx)$' > /dev/null; then
    echo "🔍 Verificando tipos TypeScript..."
    
    # Executar tsc apenas para validação rápida
    cd frontend 2>/dev/null || exit 0
    if ! npx tsc --noEmit --skipLibCheck 2>/dev/null; then
        echo "❌ COMMIT BLOQUEADO: Erros de tipo TypeScript detectados"
        echo "Execute 'cd frontend && npx tsc --noEmit' para ver os erros"
        exit 1
    fi
    
    echo "✅ Tipos TypeScript válidos"
fi

exit 0
