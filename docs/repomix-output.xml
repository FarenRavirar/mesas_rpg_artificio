ALTER TABLE aggregator_import_candidates 
ADD COLUMN IF NOT EXISTS master_display_name VARCHAR(255),
ADD COLUMN IF NOT EXISTS recruiter_name VARCHAR(255),
ADD COLUMN IF NOT EXISTS publisher_role VARCHAR(50),
