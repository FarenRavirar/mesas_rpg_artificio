    if (!confirm(`Rejeitar TODOS os ${pendingCount} candidatos pendentes? Esta ação não pode ser desfeita.`)) return;

    setRejectingAll(true);

    try {
      const response = await fetch(`${API_BASE}/api/v1/aggregator/candidates/reject-all`, {
