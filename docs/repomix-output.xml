        updated_at: new Date(),
      })
      .where('editorial_status', '=', 'awaiting_review')
      .executeTakeFirst();

    const rejectedCount = Number(result.numUpdatedRows || 0);

    return res.json({ 
      data: { 
        rejectedCount,
        message: `${rejectedCount} candidato(s) rejeitado(s) com sucesso.`
      } 
