# =============================================================================
# .env.example — Anúncios de Mesas RPG
# NUNCA commitar o .env real. Este arquivo é o template com placeholders.
# Copiar para .env e preencher com valores reais antes de subir os containers.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de Dados
# -----------------------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=SUBSTITUIR_SENHA_FORTE
POSTGRES_DB=mesas_rpg
DATABASE_URL=postgresql://admin:SUBSTITUIR_SENHA_FORTE@mesas-beta-db:5432/mesas_rpg

# -----------------------------------------------------------------------------
# Autenticação Google OAuth
# Criar credenciais em: https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=SUBSTITUIR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=SUBSTITUIR_CLIENT_SECRET
# Beta:
GOOGLE_CALLBACK_URL=https://mesasbeta.artificiorpg.com/auth/google/callback
# Produção (alterar no .env de prod):
# GOOGLE_CALLBACK_URL=https://mesas.artificiorpg.com/auth/google/callback

# -----------------------------------------------------------------------------
# JWT
# Gerar segredos com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET=SUBSTITUIR_JWT_SECRET_64_BYTES_HEX
JWT_REFRESH_SECRET=SUBSTITUIR_JWT_REFRESH_SECRET_64_BYTES_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
# Beta:
FRONTEND_URL=https://mesasbeta.artificiorpg.com
# Produção (alterar no .env de prod):
# FRONTEND_URL=https://mesas.artificiorpg.com

# -----------------------------------------------------------------------------
# Imgur (upload de imagens de conteúdo)
# Registrar app em: https://api.imgur.com/oauth2/addclient (Anonymous usage)
# NUNCA expor este valor no frontend ou commitar com valor real
# -----------------------------------------------------------------------------
IMGUR_CLIENT_ID=SUBSTITUIR_IMGUR_CLIENT_ID

# -----------------------------------------------------------------------------
# AggregatorBot (Fase 7 — bloqueado até Fases 1-5 validadas)
# -----------------------------------------------------------------------------
AGGREGATOR_CRON_SCHEDULE=0 6 * * *
AGGREGATOR_DRY_RUN=false
