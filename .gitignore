# Variáveis de ambiente — NUNCA versionar
.env
.env.local
.env.production
.env.beta
.env.*.local

# Dependências
node_modules/
**/node_modules/

# Builds
dist/
build/
**/dist/
frontend/dist/
backend/dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Chaves SSH — NUNCA versionar
*.key
*.pem
*.pub
ssh-key-*

# Dumps de banco — NUNCA versionar
*.sql.gz
*_dump.sql
*_backup.sql
*pre_cutover*

# Arquivos de sistema
.DS_Store
Thumbs.db
PROMPT_CODEX_TASK.md

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Testes (scripts temporários de diagnóstico)
testes/

# TypeScript cache
*.tsbuildinfo

secrets.txt
*.key
*.pub
ambiente_atual_mesas.md
tmp/cenarios.json
tmp/sistemas.json
tmp/catalogo_completo_sistemas.md
